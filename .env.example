# TrialPulse environment. Copy to .env.local. Never commit real values.
# Public Demo at /demo runs with none of these set.

# --- Supabase (Auth, Postgres, private Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# Workspace created by `npm run seed`. Leave blank to let the seed script assign one.
TRIALPULSE_WORKSPACE_ID=

# --- Gemini receipt extraction (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- PayPal Sandbox Standard Payouts (server only) ---
# The controlled Sandbox *sender* is the business account behind these REST credentials.
# Confirm that account can submit Standard Payouts before a live demo.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal developer dashboard (Sandbox), used to verify signatures.
PAYPAL_WEBHOOK_ID=
# Email of the controlled Sandbox sender. Stored for operators; not sent as a receipt note.
PAYPAL_SENDER_EMAIL=

# Seeded claimant destination. This must be a controlled Sandbox personal account
# that you can inspect. The app pays this verified recipient and no one else in v1.
SANDBOX_RECIPIENT_EMAIL=

# Seeded operator (coordinator + finance) and claimant accounts. Created by `npm run seed`.
SANDBOX_OPERATOR_EMAIL=
SANDBOX_OPERATOR_PASSWORD=
SANDBOX_CLAIMANT_EMAIL=
SANDBOX_CLAIMANT_PASSWORD=

# Protects the reconciliation worker HTTP trigger and script.
WORKER_SECRET=

# Optional public URL of this deployment, used in absolute links and webhook setup notes.
APP_BASE_URL=http://localhost:3000
